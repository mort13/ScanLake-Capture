{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scanlake-capture",
  "compatibility_date": "2026-04-08",
  "routes": [
    { "pattern": "capture.scanlake.rocks", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
